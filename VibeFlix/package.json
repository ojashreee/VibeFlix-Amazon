{
  "name": "amazon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  
"scripts": {
  "dev": "concurrently -k -n FRONTEND,SOCIAL,AI,TMDB \"npm:dev:frontend\" \"npm:server\" \"npm:vibesearch\" \"npm:tmdb\"",
  "dev:frontend": "vite",
  "build": "vite build",
  "preview": "vite preview",
  "server": "node server/index.mjs",
  "tmdb": "node --env-file=.env server/tmdb-server.mjs",
  "vibesearch": "node --env-file=.env server/vibesearch-server.mjs"
}
,
  "dependencies": {
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
